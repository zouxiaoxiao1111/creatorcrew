# ============================================================
# CreatorCrew 配置示例：复制为 .env 后按需修改（cp .env.example .env）
# 不要把真实的 .env 提交到 Git！
# ============================================================

# 版本：selfhost（自部署，单租户）| cloud（官方在线版，多租户，需要 ee/）
CC_EDITION=selfhost

# 对外访问地址
CC_BASE_URL=http://localhost:3000
CC_PORT=3000

# 【必填】加密主密钥：用来加密保存在数据库里的模型 API Key（AES-256-GCM），至少 16 个字符。
# 生成方法（任选其一）：
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 配置了数据库（非演示模式）却没有设置它时，web 和 worker 都会拒绝启动。
# 务必备份！丢失或更换后，已保存的 API Key 无法解密，需要在「设置」里重新填写。
CC_SECRET_KEY=

# 数据库密码（docker compose 中的 Postgres 使用）
PG_PASSWORD=creatorcrew
# 不用 docker compose 时，直接填完整连接串；留空则 Web 进入「演示模式」（内存数据）
# DATABASE_URL=postgres://creatorcrew:creatorcrew@localhost:5432/creatorcrew
# 连接池大小（默认 10）
# CC_DB_POOL_MAX=10

# 是否开放注册（自部署默认关闭；在线版默认开启）
# 自部署版只有一个管理员账号：首次打开网页时在 /setup 创建，之后在 /login 登录
CC_ALLOW_SIGNUP=false
# 导出 / 发布前是否必须经过人工审核（强烈建议保持 true）
CC_REQUIRE_APPROVAL=true
# 设为 true 可在 ee/ 存在时也不加载它
CC_DISABLE_EE=false
# 时区（定时任务和界面显示）
CC_TIMEZONE=Asia/Shanghai

# ---------------- 模型 Provider ----------------
# 推荐：登录后在 Web「设置 → 模型 Provider 凭据」里填写（加密保存）。
# 下面的环境变量作为兜底；「设置」里保存了同名 Provider 时以页面为准。
# OpenAI 或任何 OpenAI 兼容接口
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
# OpenRouter
OPENROUTER_API_KEY=
# Ollama 本地模型（docker compose --profile ollama up -d 时用 http://ollama:11434/v1）
OLLAMA_BASE_URL=

# 档位 → 模型（逗号分隔即 fallback 顺序）
# 优先级：设置页的「档位映射」> 设置页 Provider 凭据里填的档位模型 > 这里的环境变量
# 格式：provider:model，例如 openai:模型名,openrouter:模型名
CC_TIER_CHEAP=
CC_TIER_MID=
CC_TIER_STRONG=
CC_TIER_LOCAL=

# ---------------- 连接器（可选） ----------------
# X 官方 API Bearer Token（付费，档位和价格以 X 官方最新条款为准）。不填则选题雷达只用 RSS / 灵感库
X_API_BEARER=

# ---------------- 存储 ----------------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/storage
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

LOG_LEVEL=info

# ---------------- 在线版登录方式（仅 CC_EDITION=cloud，开发中） ----------------
# 自部署版只用邮箱 + 密码，不需要这些。以下 Provider 目前只预留结构，界面显示「即将支持」。
# AUTH_EMAIL_FROM=
# SMTP_URL=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
