{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalPassThroughEnv": [
    "CC_*",
    "DATABASE_URL",
    "OPENAI_*",
    "OPENROUTER_*",
    "OLLAMA_*",
    "X_API_BEARER",
    "STORAGE_DRIVER",
    "S3_*",
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "typecheck": {},
    "lint": {},
    "test": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
